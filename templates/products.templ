package templates

import (
	"Domicile/internal/models"
	"Domicile/templates/partials"
)

// ProductsContent is the inner content — used by htmx partial swaps.
templ ProductsContent(products []models.Product) {
	<div id="products-area">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div role="heading" aria-level="2" class="h2"><i class="bi bi-box-seam me-2"></i>Products</div>
			<div class="d-flex gap-2 align-items-center">
				<div class="input-group" style="max-width: 250px;">
					<span class="input-group-text"><i class="bi bi-search"></i></span>
					<input type="text" class="form-control" id="product-search"
						placeholder="Search products..." autocomplete="off" aria-label="Search products" aria-label="Search products"
						oninput="filterTable(this.value, 'product-table-body')"/>
				</div>
			</div>
		</div>
		@partials.ProductTable(products)
		<!-- Sticky Add button -->
		<button class="btn btn-primary btn-lg rounded-circle shadow position-fixed"
			style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1050;"
			hx-get="/products/new"
			hx-target="#products-area"
			hx-swap="innerHTML"
			title="Add Product" aria-label="Add Product">
			<i class="bi bi-plus-lg"></i>
		</button>
	</div>
}

// ProductsPage is the full page — used for direct browser navigation.
templ ProductsPage(products []models.Product) {
	@Layout("Products") {
		@ProductsContent(products)
	}
}
