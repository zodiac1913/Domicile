package templates

// SettingsContent is the inner content — the top-level settings menu.
templ SettingsContent() {
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div role="heading" aria-level="2" class="h2"><i class="bi bi-gear me-2"></i>Settings</div>
	</div>
	<div id="settings-panel">
		<div class="list-group">
			<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
				href="#"
				hx-get="/settings/field-visibility"
				hx-target="#settings-panel"
				hx-swap="innerHTML"
				hx-push-url="false">
				<div>
					<div class="fw-semibold"><i class="bi bi-eye me-2"></i>Field Visibility</div>
					<small class="text-body-secondary">Show or hide fields on each table</small>
				</div>
				<i class="bi bi-chevron-right text-body-secondary"></i>
			</a>
			<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
				href="#"
				hx-get="/settings/shopping"
				hx-target="#settings-panel"
				hx-swap="innerHTML"
				hx-push-url="false">
				<div>
					<div class="fw-semibold"><i class="bi bi-cart3 me-2"></i>Shopping</div>
					<small class="text-body-secondary">Shopping list behavior and stock integration</small>
				</div>
				<i class="bi bi-chevron-right text-body-secondary"></i>
			</a>
			<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
				href="#"
				hx-get="/settings/backup"
				hx-target="#settings-panel"
				hx-swap="innerHTML"
				hx-push-url="false">
				<div>
					<div class="fw-semibold"><i class="bi bi-cloud-arrow-down me-2"></i>Backup &amp; Restore</div>
					<small class="text-body-secondary">Download or restore a database backup</small>
				</div>
				<i class="bi bi-chevron-right text-body-secondary"></i>
			</a>
		</div>
	</div>
}

// SettingsPage is the full page wrapper.
templ SettingsPage() {
	@Layout("Settings") {
		@SettingsContent()
	}
}
