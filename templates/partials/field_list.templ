package partials

import "Domicile/internal/models"

// SettingsFieldVisibility shows the list of tables to configure — the second drill-down level.
templ SettingsFieldVisibility(tables []models.TableInfo) {
	<div class="mb-3">
		<a href="#" class="btn btn-sm btn-outline-secondary"
			hx-get="/settings"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="/settings">
			<i class="bi bi-arrow-left me-1"></i>Back to Settings
		</a>
	</div>
	<div role="heading" aria-level="5" class="mb-3"><i class="bi bi-eye me-2"></i>Field Visibility</div>
	<div class="list-group">
		for _, t := range tables {
			<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
				href="#"
				hx-get={ "/settings/fields?table=" + t.Name }
				hx-target="#settings-panel"
				hx-swap="innerHTML"
				hx-push-url="false">
				<div>
					<div class="fw-semibold">{ t.DisplayName }</div>
					<small class="text-body-secondary">{ t.Description }</small>
				</div>
				<i class="bi bi-chevron-right text-body-secondary"></i>
			</a>
		}
	</div>
}

// FieldList shows the toggle switches for a single table.
templ FieldList(tableName string, displayName string, fields []models.FieldInfo) {
	<div class="mb-3">
		<a href="#" class="btn btn-sm btn-outline-secondary"
			hx-get="/settings/field-visibility"
			hx-target="#settings-panel"
			hx-swap="innerHTML"
			hx-push-url="false">
			<i class="bi bi-arrow-left me-1"></i>Back to Tables
		</a>
	</div>
	<div role="heading" aria-level="5" class="mb-3">{ displayName } — Fields</div>
	if len(fields) == 0 {
		<p class="text-body-secondary py-3">No configurable fields for this table.</p>
	} else {
		<div class="list-group list-group-striped" id="field-toggle-list">
			for _, f := range fields {
				<div class="list-group-item d-flex justify-content-between align-items-center cursor-pointer field-row"
					data-table={ tableName } data-field={ f.Name }>
					<span>
						{ f.DisplayName }
						if f.Description != "" {
							<i class="bi bi-info-circle text-body-secondary ms-1"
								data-bs-toggle="tooltip"
								data-bs-placement="top"
								title={ f.Description }></i>
						}
					</span>
					<div class="form-check form-switch mb-0">
						<input class="form-check-input field-cb" type="checkbox" role="switch"
							if !f.Hidden {
								checked
							}
							aria-label={ "Toggle visibility for " + f.DisplayName }
						/>
					</div>
				</div>
			}
		</div>
		<script>
			(function() {
				var list = document.getElementById('field-toggle-list');
				if (!list) return;
				list.addEventListener('click', function(e) {
					// Don't toggle on tooltip icon click
					if (e.target.closest('[data-bs-toggle="tooltip"]')) return;
					var row = e.target.closest('.field-row');
					if (!row) return;
					var cb = row.querySelector('.field-cb');
					// If they clicked the checkbox itself, it already toggled
					if (e.target !== cb) {
						cb.checked = !cb.checked;
					}
					var hidden = cb.checked ? '0' : '1';
					fetch('/settings/toggle-field', {
						method: 'POST',
						headers: {'Content-Type': 'application/x-www-form-urlencoded'},
						body: 'table_name=' + row.dataset.table + '&field_name=' + row.dataset.field + '&hidden=' + hidden
					});
				});
			})();
		</script>
	}
}
