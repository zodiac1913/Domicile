package partials

templ BackupRestore() {
	<div class="mb-3">
		<a href="#" class="btn btn-sm btn-outline-secondary"
			hx-get="/settings"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="/settings">
			<i class="bi bi-arrow-left me-1"></i>Back to Settings
		</a>
	</div>
	<div role="heading" aria-level="5" class="mb-4"><i class="bi bi-cloud-arrow-down me-2"></i>Backup &amp; Restore</div>
	<!-- Backup -->
	<div class="card mb-4">
		<div class="card-body">
			<div role="heading" aria-level="6" class="card-title"><i class="bi bi-download me-2"></i>Download Backup</div>
			<p class="text-body-secondary mb-3">
				Downloads a compressed copy of your entire database. Keep this file safe.
			</p>
			<a href="/settings/backup/download" class="btn btn-primary">
				<i class="bi bi-cloud-arrow-down me-1"></i>Download Backup
			</a>
		</div>
	</div>
	<!-- Restore -->
	<div class="card">
		<div class="card-body">
			<div role="heading" aria-level="6" class="card-title"><i class="bi bi-upload me-2"></i>Restore from Backup</div>
			<p class="text-body-secondary mb-3">
				Upload a previously downloaded backup file to replace the current database.
				This will overwrite all current data.
			</p>
			<form hx-post="/settings/backup/restore" hx-encoding="multipart/form-data"
				hx-confirm="This will replace ALL current data with the backup. Are you sure?"
				hx-target="#main-content" hx-swap="innerHTML">
				<div class="input-group" style="max-width: 500px;">
					<input type="file" class="form-control" name="backup" accept=".gz" required/>
					<button type="submit" class="btn btn-danger">
						<i class="bi bi-cloud-arrow-up me-1"></i>Restore
					</button>
				</div>
			</form>
		</div>
	</div>
}
