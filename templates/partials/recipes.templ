package partials

import (
	"Domicile/internal/models"
	"strings"
	"strconv"
)

templ RecipeGrid(recipes []models.Recipe) {
	<div class="row g-3" id="recipe-grid">
		for _, r := range recipes {
			@RecipeCard(r)
		}
	</div>
	if len(recipes) == 0 {
		<p class="text-center text-body-secondary py-5">No recipes yet. Import one from a URL or add manually.</p>
	}
}

templ RecipeCard(r models.Recipe) {
	<div class="col-sm-6 col-md-6 col-lg-4 col-xl-3 recipe-card">
		<div class="card h-100" style="cursor: pointer; min-height: 275px;"
			hx-get={ "/recipes/" + r.IDStr() }
			hx-target="#main-content" hx-swap="innerHTML" hx-push-url={ "/recipes/" + r.IDStr() }>
			if r.HasImage == 1 {
				<img src={ "/recipes/" + r.IDStr() + "/image" } class="card-img-top" style="height: 200px; object-fit: cover;" alt={ r.Name }
					loading="lazy"/>
			} else if r.Image != "" && imageIsURL(r.Image) {
				<img src={ r.Image } class="card-img-top" style="height: 200px; object-fit: cover;" alt={ r.Name }
					loading="lazy"/>
			} else {
				<div class="card-img-top d-flex align-items-center justify-content-center" style="height: 200px; background: rgba(255,255,255,0.05);">
					<i class="bi bi-journal-text fs-1 text-body-secondary"></i>
				</div>
			}
			<div class="card-body p-3">
				<div class="fw-semibold mb-1" style="line-height: 1.3;">{ r.Name }</div>
				<div class="d-flex align-items-center justify-content-between">
					if r.Rating != nil && *r.Rating > 0 {
						<span class="text-warning small">
							{ renderStars(*r.Rating) }
						</span>
					} else {
						<span class="text-body-secondary small">
							{ renderStars(0) }
						</span>
					}
					if r.TotalTime != "" {
						<small class="text-body-secondary"><i class="bi bi-clock me-1"></i>{ r.TotalTime }</small>
					}
				</div>
			</div>
		</div>
	</div>
}

func renderStars(rating float64) string {
	full := int(rating)
	result := ""
	for i := 0; i < full; i++ {
		result += "★ "
	}
	for i := full; i < 5; i++ {
		result += "☆ "
	}
	return result
}

func imageIsURL(s string) bool {
	return strings.HasPrefix(s, "http://") || strings.HasPrefix(s, "https://")
}

templ RecipeView(r models.RecipeDetail) {
	<div class="mb-3 d-flex justify-content-between">
		<button class="btn btn-sm btn-outline-secondary"
			hx-get="/recipes" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/recipes">
			<i class="bi bi-arrow-left me-1"></i>Back to Recipes
		</button>
		<div class="d-flex gap-2">
			<button class="btn btn-sm btn-outline-warning"
				hx-get={ "/recipes/" + r.IDStr() + "/edit" }
				hx-target="#main-content" hx-swap="innerHTML"
				title="Edit" aria-label="Edit recipe">
				<i class="bi bi-pencil me-1"></i>Edit
			</button>
			<button class="btn btn-sm btn-outline-danger"
				hx-delete={ "/recipes/" + r.IDStr() }
				hx-target="#main-content" hx-swap="innerHTML"
				hx-confirm="Delete this recipe?" hx-push-url="/recipes"
				title="Delete" aria-label="Delete recipe">
				<i class="bi bi-trash me-1"></i>Delete
			</button>
		</div>
	</div>
	<!-- Hero section: title + image side by side -->
	<div class="card mb-4">
		<div class="row g-0">
			<div class="col-md-6 d-flex flex-column justify-content-center p-4">
				<div class="text-center">
					<div role="heading" aria-level="2" class="h3 mb-2">{ r.Name }</div>
					if r.Rating != nil && *r.Rating > 0 {
						<div class="text-warning fs-5 mb-2">{ renderStars(*r.Rating) }</div>
					} else {
						<div class="text-body-secondary fs-5 mb-2">{ renderStars(0) }</div>
					}
					if r.Description != "" {
						<p class="text-body-secondary">@templ.Raw(r.Description)</p>
					}
					<hr class="my-3"/>
					<!-- Time cards -->
					<div class="d-flex justify-content-center gap-4 flex-wrap">
						if r.TotalTime != "" {
							<div class="text-center">
								<i class="bi bi-clock text-primary fs-4"></i>
								<div class="small fw-semibold mt-1">Total Time</div>
								<div class="small text-body-secondary">{ r.TotalTime }</div>
							</div>
						}
						if r.PrepTime != "" {
							<div class="text-center">
								<i class="bi bi-hourglass-split text-primary fs-4"></i>
								<div class="small fw-semibold mt-1">Prep Time</div>
								<div class="small text-body-secondary">{ r.PrepTime }</div>
							</div>
						}
						if r.CookTime != "" {
							<div class="text-center">
								<i class="bi bi-fire text-primary fs-4"></i>
								<div class="small fw-semibold mt-1">Cook Time</div>
								<div class="small text-body-secondary">{ r.CookTime }</div>
							</div>
						}
					</div>
					if r.RecipeYield != "" {
						<div class="mt-3">
							<span class="badge text-bg-secondary"><i class="bi bi-people me-1"></i>Serves { r.RecipeYield }</span>
						</div>
					}
				</div>
			</div>
			<div class="col-md-6">
				<img src={ "/recipes/" + r.IDStr() + "/image" } class="img-fluid rounded-end" style="height: 400px; width: 100%; object-fit: cover;" alt={ r.Name }
					onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
				<div class="flex-column align-items-center justify-content-center rounded-end" style="height: 400px; background: rgba(255,255,255,0.05); display: none;">
					<i class="bi bi-journal-text mb-3" style="font-size: 4rem; opacity: 0.3;"></i>
					<div class="d-flex gap-2">
						if r.SourceURL != "" {
							<button class="btn btn-sm btn-outline-info"
								hx-post={ "/recipes/" + r.IDStr() + "/fetch-image" }
								hx-target="#main-content" hx-swap="innerHTML">
								<i class="bi bi-download me-1"></i>Fetch Image
							</button>
						}
						<form hx-post={ "/recipes/" + r.IDStr() + "/image" } hx-encoding="multipart/form-data" hx-target="#main-content" hx-swap="innerHTML" class="d-inline">
							<label class="btn btn-sm btn-outline-secondary">
								<i class="bi bi-upload me-1"></i>Upload
								<input type="file" name="image" accept="image/*" class="d-none" onchange="this.closest('form').requestSubmit()"/>
							</label>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Ingredients + Instructions -->
	<div class="row">
		<div class="col-md-4 mb-4">
			if len(r.Ingredients) > 0 {
				<div class="card">
					<div class="card-header">
						<i class="bi bi-basket me-2"></i>Ingredients
					</div>
					<div class="card-body p-0">
						for _, ing := range r.Ingredients {
							<div class="d-flex align-items-start p-2 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
								<input type="checkbox" class="form-check-input me-2 mt-1 ingredient-check" style="flex-shrink: 0;"/>
								<span class="ingredient-text">{ ing.Text }</span>
							</div>
						}
					</div>
				</div>
			}
			<!-- Categories -->
			if len(r.Categories) > 0 {
				<div class="card mt-3">
					<div class="card-header py-2">Categories</div>
					<div class="card-body">
						for _, cat := range r.Categories {
							<span class="badge text-bg-info me-1 mb-1">{ cat }</span>
						}
					</div>
				</div>
			}
			<!-- Tags -->
			if len(r.Tags) > 0 {
				<div class="card mt-3">
					<div class="card-header py-2">Tags</div>
					<div class="card-body">
						for _, tag := range r.Tags {
							<span class="badge text-bg-dark me-1 mb-1">{ tag }</span>
						}
					</div>
				</div>
			}
		</div>
		<div class="col-md-8">
			if len(r.Instructions) > 0 {
				<div class="d-flex justify-content-between align-items-center mb-3">
					<div role="heading" aria-level="4" class="h5 mb-0"><i class="bi bi-list-ol me-2"></i>Instructions</div>
				</div>
				for i, step := range r.Instructions {
					<div class="card mb-3 instruction-step">
						<div class="card-body">
							<div class="d-flex align-items-center mb-2">
								<span class="badge text-bg-primary me-2">Step { strconv.Itoa(i + 1) }</span>
								if step.Title != "" {
									<span class="fw-semibold">{ step.Title }</span>
								}
							</div>
							<p class="mb-0">{ step.Text }</p>
						</div>
					</div>
				}
			}
			if r.SourceURL != "" {
				<div class="text-end mt-3">
					<a href={ templ.SafeURL(r.SourceURL) } target="_blank" class="btn btn-sm btn-outline-info">
						<i class="bi bi-globe2 me-1"></i>Original Recipe
					</a>
				</div>
			}
		</div>
	</div>
	<!-- Ingredient strikethrough on check -->
	<script>
		document.querySelectorAll('.ingredient-check').forEach(function(cb) {
			cb.addEventListener('change', function() {
				var text = cb.closest('div').querySelector('.ingredient-text');
				if (cb.checked) {
					text.style.textDecoration = 'line-through';
					text.style.opacity = '0.5';
				} else {
					text.style.textDecoration = 'none';
					text.style.opacity = '1';
				}
			});
		});
	</script>
}

templ RecipeForm(r *models.RecipeDetail) {
	<div class="mb-3">
		<button class="btn btn-sm btn-outline-secondary"
			hx-get="/recipes" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/recipes">
			<i class="bi bi-arrow-left me-1"></i>Back to Recipes
		</button>
	</div>
	if r != nil {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-pencil me-2"></i>Edit Recipe</div>
	} else {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-plus-lg me-2"></i>New Recipe</div>
	}
	<div class="card"><div class="card-body">
		if r != nil {
			<form hx-post={ "/recipes/" + r.IDStr() + "/update" }
				hx-encoding="multipart/form-data"
				hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/recipes">
				@recipeFormFields(r)
			</form>
		} else {
			<form hx-post="/recipes"
				hx-encoding="multipart/form-data"
				hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/recipes">
				@recipeFormFields(nil)
			</form>
		}
	</div></div>
}

templ recipeFormFields(r *models.RecipeDetail) {
	<div class="row g-3">
		<div class="col-md-6">
			<label for="name" class="form-label">Name</label>
			<input type="text" class="form-control" id="name" name="name" required
				if r != nil { value={ r.Name } }
			/>
		</div>
		<div class="col-md-6">
			<label for="source_url" class="form-label">Source URL</label>
			<input type="url" class="form-control" id="source_url" name="source_url"
				if r != nil { value={ r.SourceURL } }
			/>
		</div>
		<div class="col-12">
			<label for="description" class="form-label">Description</label>
			<textarea class="form-control" id="description" name="description" rows="2">
				if r != nil {
					{ r.Description }
				}
			</textarea>
		</div>
		<div class="col-md-3">
			<label for="prep_time" class="form-label">Prep Time</label>
			<input type="text" class="form-control" id="prep_time" name="prep_time" placeholder="e.g. 15 min"
				if r != nil { value={ r.PrepTime } }
			/>
		</div>
		<div class="col-md-3">
			<label for="cook_time" class="form-label">Cook Time</label>
			<input type="text" class="form-control" id="cook_time" name="cook_time" placeholder="e.g. 30 min"
				if r != nil { value={ r.CookTime } }
			/>
		</div>
		<div class="col-md-3">
			<label for="total_time" class="form-label">Total Time</label>
			<input type="text" class="form-control" id="total_time" name="total_time" placeholder="e.g. 45 min"
				if r != nil { value={ r.TotalTime } }
			/>
		</div>
		<div class="col-md-3">
			<label for="recipe_yield" class="form-label">Yield / Servings</label>
			<input type="text" class="form-control" id="recipe_yield" name="recipe_yield" placeholder="e.g. 4 servings"
				if r != nil { value={ r.RecipeYield } }
			/>
		</div>
		<div class="col-md-6">
			<label for="ingredients" class="form-label">Ingredients (one per line)</label>
			<textarea class="form-control" id="ingredients" name="ingredients" rows="8">
				if r != nil {
					{ joinIngredients(r.Ingredients) }
				}
			</textarea>
		</div>
		<div class="col-md-6">
			<label for="instructions" class="form-label">Instructions (one step per line)</label>
			<textarea class="form-control" id="instructions" name="instructions" rows="8">
				if r != nil {
					{ joinInstructions(r.Instructions) }
				}
			</textarea>
		</div>
		<div class="col-md-6">
			<label for="tags" class="form-label">Tags (comma separated)</label>
			<input type="text" class="form-control" id="tags" name="tags"
				if r != nil { value={ joinTags(r.Tags) } }
			/>
		</div>
		<div class="col-md-6">
			<label for="recipe_image" class="form-label">Recipe Image</label>
			if r != nil {
				<div class="mb-2">
					<img src={ "/recipes/" + r.IDStr() + "/image" } class="img-thumbnail" style="max-height: 150px;"
						alt="Current image" onerror="this.style.display='none'"/>
				</div>
			}
			<input type="file" class="form-control" id="recipe_image" name="recipe_image" accept="image/*"/>
		</div>
		<div class="col-12 mt-3">
			<button type="submit" class="btn btn-success me-2">
				<i class="bi bi-check-lg me-1"></i>
				if r != nil {
					Save Changes
				} else {
					Create Recipe
				}
			</button>
			<button type="button" class="btn btn-outline-secondary"
				hx-get="/recipes" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/recipes">
				Cancel
			</button>
		</div>
	</div>
}

func joinIngredients(ingrs []models.RecipeIngredient) string {
	var lines []string
	for _, i := range ingrs {
		lines = append(lines, i.Text)
	}
	return strings.Join(lines, "\n")
}

func joinInstructions(instrs []models.RecipeInstruction) string {
	var lines []string
	for _, i := range instrs {
		lines = append(lines, i.Text)
	}
	return strings.Join(lines, "\n")
}

func joinTags(tags []string) string {
	return strings.Join(tags, ", ")
}
