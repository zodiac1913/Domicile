package partials

import (
	"Domicile/internal/models"
	"strconv"
)

templ ShoppingRow(item models.ShoppingListItem) {
	<tr id={ "shopping-" + item.IDStr() }
		class={ templ.KV("text-decoration-line-through text-body-secondary", item.IsDone()) }>
		<td class="fit-content">
			<button class="btn btn-sm btn-outline-success"
				hx-post={ "/shopping/" + item.IDStr() + "/toggle" }
				hx-target={ "#shopping-" + item.IDStr() }
				hx-swap="outerHTML"
				title="Toggle done">
				if item.IsDone() {
					<i class="bi bi-check-circle-fill"></i>
				} else {
					<i class="bi bi-circle"></i>
				}
			</button>
		</td>
		<td>
			{ item.DisplayName() }
			if item.Note != "" && item.ProductName != "" {
				<br/><small class="text-body-secondary">{ item.Note }</small>
			}
		</td>
		<td class="text-body-secondary small">{ item.ProductGroup }</td>
		<td>
			if item.HomeLoc != "" {
				<span class="badge text-bg-secondary"><i class="bi bi-house me-1"></i>{ item.HomeLoc }</span>
			}
		</td>
		<td>{ item.AmountStr() }</td>
		<td class="text-body-secondary">{ item.PriceStr() }</td>
		<td>
			if item.ProductGroup == "Ungrouped" && item.ProductID != nil && !item.IsDone() {
				<div class="d-inline-block group-assign-wrap" data-item-id={ item.IDStr() }>
					<button class="btn btn-sm btn-outline-info me-1 ga-btn"
						title="Assign aisle/group" aria-label="Assign product group">
						<i class="bi bi-geo-alt"></i>
					</button>
					<div class="d-none group-assign-form">
						<select class="form-select form-select-sm d-inline-block ga-select" style="width: auto; max-width: 200px;">
							<option value="">Pick group...</option>
						</select>
					</div>
				</div>
			}
			<button class="btn btn-sm btn-outline-warning me-1"
				hx-get={ "/shopping/" + item.IDStr() + "/edit" }
				hx-target="#shopping-area"
				hx-swap="innerHTML"
				title="Edit">
				<i class="bi bi-pencil"></i>
			</button>
			<button class="btn btn-sm btn-outline-danger"
				hx-delete={ "/shopping/" + item.IDStr() }
				hx-target={ "#shopping-" + item.IDStr() }
				hx-swap="outerHTML swap:200ms"
				hx-confirm="Remove this item?"
				title="Delete">
				<i class="bi bi-trash"></i>
			</button>
		</td>
	</tr>
}

templ ShoppingTable(items []models.ShoppingListItem) {
	<div class="table-responsive">
		<table class="table table-hover align-middle" role="table">
			<thead>
				<tr>
					<th style="width: 50px;"></th>
					<th>Item</th>
					<th>Aisle</th>
					<th>Home</th>
					<th>Qty</th>
					<th>Price</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody id="shopping-table-body">
				for _, item := range items {
					@ShoppingRow(item)
				}
			</tbody>
		</table>
	</div>
	if len(items) == 0 {
		<p class="text-center text-body-secondary py-3">Shopping list is empty. Add items or use "Add Missing Stock".</p>
	}
}

templ ShoppingItemForm(item *models.ShoppingListItem, products []models.Location, frequentProducts []models.Location, currentItems []models.ShoppingListItem, freqOnly bool) {
	<div class="mb-3">
		<button class="btn btn-sm btn-outline-secondary"
			hx-get="/shopping"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="/shopping">
			<i class="bi bi-arrow-left me-1"></i>Back to Shopping List
		</button>
	</div>
	if item != nil {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-pencil me-2"></i>Edit Item</div>
	} else {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-plus-lg me-2"></i>Add Item</div>
	}
	<div class="card">
		<div class="card-body">
			if item != nil {
				<form hx-put={ "/shopping/" + item.IDStr() }
					hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/shopping">
					@shoppingFormFields(item, products, frequentProducts, false)
				</form>
			} else {
				<form id="shopping-add-form">
					@shoppingFormFields(nil, products, frequentProducts, freqOnly)
				</form>
			}
		</div>
	</div>
	if len(currentItems) > 0 {
		<div class="card mt-3">
			<div class="card-body py-2">
				<small class="text-body-secondary d-block mb-1">Already on list:</small>
				<div class="small text-body-secondary" style="columns: 2; column-gap: 2rem;">
					for _, ci := range currentItems {
						if !ci.IsDone() {
							<div>{ ci.AmountStr() } { ci.DisplayName() }</div>
						}
					}
				</div>
			</div>
		</div>
	}
	<script>
		// Show one product <select> and hide the other. Both selects always keep
		// their own name and stay enabled — the server just uses whichever one
		// carries a value. No disabling, ever.
		function toggleFrequentProducts(on) {
			var allSel = document.getElementById('product_id');
			var freqSel = document.getElementById('product_id_freq');
			var hidden = document.getElementById('freq-only-input');
			if (!allSel || !freqSel) return;
			allSel.classList.toggle('d-none', on);
			freqSel.classList.toggle('d-none', !on);
			if (hidden) hidden.value = on ? '1' : '0';
			// Persist the choice so it survives browser restarts.
			try { localStorage.setItem('domicile.freqPurchasedOnly', on ? '1' : '0'); } catch (e) {}
		}
		// On a fresh full-page load the server can't know localStorage, so apply
		// the saved preference once. On htmx swaps the server already rendered the
		// right state (it receives freq_only in the form), so nothing to do there.
		(function() {
			var t = document.getElementById('freq-toggle');
			if (!t) return;
			var saved = '0';
			try { saved = localStorage.getItem('domicile.freqPurchasedOnly') || '0'; } catch (e) {}
			var on = saved === '1';
			if (on !== t.checked) {
				t.checked = on;
				toggleFrequentProducts(on);
			}
		})();
	</script>
}

templ shoppingFormFields(item *models.ShoppingListItem, products []models.Location, frequentProducts []models.Location, freqOnly bool) {
	<div class="row g-3">
		<div class="col-md-5">
			<label for="product_id" class="form-label">Product (optional)</label>
			if len(frequentProducts) > 0 && item == nil {
				<div class="form-check form-switch mb-2">
					<input class="form-check-input" type="checkbox" role="switch" id="freq-toggle"
						if freqOnly {
							checked
						}
						onchange="toggleFrequentProducts(this.checked)"/>
					<label class="form-check-label" for="freq-toggle">
						<small>Frequently purchased only</small>
					</label>
				</div>
				// Carries the toggle state to the server on Add & Continue so the
				// correct select is rendered active without relying on post-swap JS.
				<input type="hidden" id="freq-only-input" name="freq_only"
					if freqOnly {
						value="1"
					} else {
						value="0"
					}/>
			}
			<select
				class={ "form-select", templ.KV("d-none", freqOnly && item == nil) }
				id="product_id" name="product_id">
				<option value="">— Freeform note only —</option>
				for _, p := range products {
					<option value={ strconv.Itoa(p.ID) }
						if item != nil && item.ProductID != nil && *item.ProductID == p.ID {
							selected
						}
						data-freq="all"
					>{ p.Name }</option>
				}
			</select>
			<select
				class={ "form-select", templ.KV("d-none", !(freqOnly && item == nil)) }
				id="product_id_freq" name="product_id_freq">
				<option value="">— Freeform note only —</option>
				for _, p := range frequentProducts {
					<option value={ strconv.Itoa(p.ID) }>{ p.Name }</option>
				}
			</select>
		</div>
		<div class="col-md-4">
			<label for="note" class="form-label">Note</label>
			<input type="text" class="form-control" id="note" name="note"
				placeholder="e.g. get the organic kind"
				if item != nil {
					value={ item.Note }
				}
			/>
		</div>
		<div class="col-md-2">
			<label for="amount" class="form-label">Quantity</label>
			<input type="number" class="form-control" id="amount" name="amount" min="1" step="any"
				if item != nil {
					value={ item.AmountStr() }
				} else {
					value="1"
				}
			/>
		</div>
		<div class="col-12 mt-3">
			if item != nil {
				<button type="submit" class="btn btn-success me-2">
					<i class="bi bi-check-lg me-1"></i>Save Changes
				</button>
				<button type="button" class="btn btn-outline-secondary"
					hx-get="/shopping" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/shopping">
					Cancel
				</button>
			} else {
				<button type="button" class="btn btn-primary me-2"
					hx-post="/shopping/add-continue"
					hx-target="#shopping-area" hx-swap="innerHTML"
					hx-include="#shopping-add-form">
					<i class="bi bi-plus-circle me-1"></i>Add Item &amp; Continue
				</button>
				<button type="button" class="btn btn-success me-2"
					hx-post="/shopping"
					hx-target="#main-content" hx-swap="innerHTML"
					hx-push-url="/shopping"
					hx-include="#shopping-add-form">
					<i class="bi bi-check-lg me-1"></i>Add Item
				</button>
				<button type="button" class="btn btn-outline-secondary"
					hx-get="/shopping" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/shopping">
					Cancel
				</button>
			}
		</div>
	</div>
}

// ShopModeItem renders a single item in shop mode — big touch target, tap to check off.
templ ShopModeItem(item models.ShoppingListItem) {
	<div id={ "shop-" + item.IDStr() }
		class={ "list-group-item d-flex align-items-center py-3",
			templ.KV("text-decoration-line-through text-body-secondary", item.IsDone()) }
		style="font-size: 1.1rem;">
		<span class="me-3 fs-4" style="cursor: pointer;"
			hx-post={ "/shopping/" + item.IDStr() + "/shop-toggle" }
			hx-target={ "#shop-" + item.IDStr() }
			hx-swap="outerHTML">
			if item.IsDone() {
				<i class="bi bi-check-circle-fill text-success"></i>
			} else {
				<i class="bi bi-circle text-body-secondary"></i>
			}
		</span>
		<span class="flex-grow-1" style="cursor: pointer;"
			hx-post={ "/shopping/" + item.IDStr() + "/shop-toggle" }
			hx-target={ "#shop-" + item.IDStr() }
			hx-swap="outerHTML">
			{ item.DisplayName() }
			if item.Note != "" && item.ProductName != "" {
				<br/><small class="text-body-secondary">{ item.Note }</small>
			}
			if item.HomeLoc != "" {
				<br/><small class="text-body-secondary"><i class="bi bi-house me-1"></i>{ item.HomeLoc }</small>
			}
		</span>
		if item.ProductGroup == "Ungrouped" && item.ProductID != nil && !item.IsDone() {
			<div class="group-assign-wrap ms-2" data-item-id={ item.IDStr() }>
				<button class="btn btn-sm btn-outline-info ga-btn"
					title="Assign aisle" aria-label="Assign product group">
					<i class="bi bi-geo-alt"></i>
				</button>
				<div class="d-none group-assign-form">
					<select class="form-select form-select-sm ga-select" style="width: auto; max-width: 180px;">
						<option value="">Pick group...</option>
					</select>
				</div>
			</div>
		}
		<span class="badge text-bg-secondary ms-2">{ item.AmountStr() }</span>
		if item.PriceStr() != "" {
			<small class="text-body-secondary ms-1">{ item.PriceStr() }</small>
		}
	</div>
}
