}

templ ChoreForm(c *models.Chore, listID int, users []models.User) {
	<div id={ "chore-" + c.IDStr() } class="card mb-2 border-primary">
		<div class="card-body p-2">
			<form hx-post={ "/chores/" + c.IDStr() + "/update" }
				hx-target="#main-content" hx-swap="innerHTML"
				hx-push-url={ "/chores?list_id=" + strconv.Itoa(listID) }>
				<input type="hidden" name="chore_list_id" value={ strconv.Itoa(listID) }/>
				<div class="row g-2">
					<div class="col-12">
						<input type="text" class="form-control form-control-sm" name="name" value={ c.Name } required/>
					</div>
					<div class="col-12">
						<input type="text" class="form-control form-control-sm" name="description" value={ c.Description } placeholder="Description"/>
					</div>
					<div class="col-6">
						<input type="date" class="form-control form-control-sm" name="due_date"
							if c.DueDate != "" { value={ c.DueDate[:10] } }/>
					</div>
					<div class="col-6">
						<select class="form-select form-select-sm" name="assigned_to_user_id">
							<option value="0">— Assign —</option>
							for _, u := range users {
								<option value={ u.IDStr() }
									if c.AssignedToUserID != nil && *c.AssignedToUserID == u.ID { selected }>
									{ u.FullName() }
								</option>
							}
						</select>
					</div>
					<div class="col-12 d-flex gap-2">
						<button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Save</button>
						<button type="button" class="btn btn-sm btn-outline-secondary"
							hx-get={ "/chores?list_id=" + strconv.Itoa(listID) }
							hx-target="#main-content" hx-swap="innerHTML">Cancel</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}
