package partials

import "Domicile/internal/models"

templ NavbarUserBubble(user models.User) {
	<button class="btn btn-link p-0 border-0 dropdown-toggle" type="button"
		data-bs-toggle="dropdown" aria-expanded="false" title={ user.FullName() }>
		if user.PictureFileName != "" {
			<img src={ "/images/users/" + user.PictureFileName }
				class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;"
				alt={ user.FullName() }/>
		} else {
			<div class="rounded-circle bg-primary d-flex align-items-center justify-content-center"
				style="width: 32px; height: 32px;">
				<i class="bi bi-person-fill text-white" style="font-size: 0.9rem;"></i>
			</div>
		}
	</button>
	<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
		<li class="dropdown-header">{ user.FullName() }</li>
		<li><hr class="dropdown-divider"/></li>
		<li>
			<a class="dropdown-item" href="/settings"
				hx-get="/settings" hx-target="#main-content" hx-push-url="true">
				<i class="bi bi-gear me-2"></i>Settings
			</a>
		</li>
		if user.IsAdminBool() {
			<li>
				<a class="dropdown-item" href="/admin"
					hx-get="/admin" hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-shield-lock me-2"></i>Admin
				</a>
			</li>
		}
		<li><hr class="dropdown-divider"/></li>
		<li>
			<a class="dropdown-item" href="/logout">
				<i class="bi bi-box-arrow-right me-2"></i>Sign Out
			</a>
		</li>
	</ul>
}
