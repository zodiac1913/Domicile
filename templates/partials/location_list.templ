package partials

import "Domicile/internal/models"

templ LocationRow(l models.LocationDetail) {
	<tr id={ "location-" + l.IDStr() }>
		<td>{ l.Name }</td>
		<td>@templ.Raw(l.Description)</td>
		<td>
			if l.IsFreezer == 1 {
				<span class="badge text-bg-info">Yes</span>
			} else {
				<span class="badge text-bg-secondary">No</span>
			}
		</td>
		<td>
			<button class="btn btn-sm btn-outline-warning me-1"
				hx-get={ "/locations/" + l.IDStr() + "/edit" }
				hx-target="#locations-area"
				hx-swap="innerHTML"
				title="Edit">
				<i class="bi bi-pencil"></i>
			</button>
			<button class="btn btn-sm btn-outline-danger"
				hx-delete={ "/locations/" + l.IDStr() }
				hx-target={ "#location-" + l.IDStr() }
				hx-swap="outerHTML swap:200ms"
				hx-confirm="Delete this location?"
				title="Delete">
				<i class="bi bi-trash"></i>
			</button>
		</td>
	</tr>
}

templ LocationTable(locations []models.LocationDetail) {
	<div class="table-responsive">
		<table class="table table-hover align-middle" role="table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Description</th>
					<th>Freezer</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody id="location-table-body">
				for _, l := range locations {
					@LocationRow(l)
				}
			</tbody>
		</table>
	</div>
	if len(locations) == 0 {
		<p class="text-center text-body-secondary py-3">No locations yet. Add your first one above.</p>
	}
}

templ LocationForm(loc *models.LocationDetail) {
	<div class="mb-3">
		<button class="btn btn-sm btn-outline-secondary"
			hx-get="/locations"
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="/locations">
			<i class="bi bi-arrow-left me-1"></i>Back to Locations
		</button>
	</div>
	if loc != nil {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-pencil me-2"></i>Edit Location</div>
	} else {
		<div role="heading" aria-level="3" class="mb-4"><i class="bi bi-plus-lg me-2"></i>New Location</div>
	}
	<div class="card">
		<div class="card-body">
			if loc != nil {
				<form hx-post={ "/locations/" + loc.IDStr() + "/update" }
					hx-encoding="multipart/form-data"
					hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/locations">
					@locationFormFields(loc)
				</form>
			} else {
				<form hx-post="/locations"
					hx-encoding="multipart/form-data"
					hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/locations">
					@locationFormFields(nil)
				</form>
			}
		</div>
	</div>
}

templ locationFormFields(loc *models.LocationDetail) {
	<div class="row g-3">
		<div class="col-md-4">
			<label for="name" class="form-label">Name</label>
			<input type="text" class="form-control" id="name" name="name" required
				if loc != nil {
					value={ loc.Name }
				}
			/>
		</div>
		<div class="col-md-6">
			@Wysiwyg("description", "Description", locDesc(loc))
		</div>
		<div class="col-md-2 d-flex align-items-end">
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="is_freezer" name="is_freezer" value="1"
					if loc != nil && loc.IsFreezer == 1 {
						checked
					}
				/>
				<label class="form-check-label" for="is_freezer">
					Is Freezer
				</label>
			</div>
		</div>
		<div class="col-md-4">
			<label for="picture" class="form-label">Picture</label>
			if loc != nil && loc.PictureFileName != "" {
				<div class="mb-2">
					<img src={ "/images/locations/" + loc.PictureFileName }
						class="img-thumbnail" style="max-height: 150px;" alt="Location picture"/>
				</div>
			}
			<input type="file" class="form-control" id="picture" name="picture" accept="image/*"/>
		</div>
		<div class="col-12 mt-3">
			<button type="submit" class="btn btn-success me-2">
				<i class="bi bi-check-lg me-1"></i>
				if loc != nil {
					Save Changes
				} else {
					Create Location
				}
			</button>
			<button type="button" class="btn btn-outline-secondary"
				hx-get="/locations" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/locations">
				Cancel
			</button>
		</div>
	</div>
}

func locDesc(loc *models.LocationDetail) string {
	if loc != nil {
		return loc.Description
	}
	return ""
}
