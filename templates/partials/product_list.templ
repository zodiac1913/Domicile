package partials

import "Domicile/internal/models"

// ProductRow renders a single product row.
templ ProductRow(p models.Product) {
	<tr id={ "product-" + p.IDStr() }>
		<td class="cursor-pointer"
			hx-get={ "/products/" + p.IDStr() }
			hx-target="#products-area"
			hx-swap="innerHTML">
			{ p.Name }
		</td>
		<td>{ p.Location }</td>
		<td>
			<span class={ "badge", stockBadgeClass(p) }>
				{ p.QuantityStr() }
			</span>
		</td>
		<td>{ p.ExpiresDisplay() }</td>
		<td>
			<div class="d-flex flex-wrap gap-1" style="max-width: 160px;">
				<button class="btn btn-outline-info btn-sm p-0 px-1"
					hx-post={ "/products/" + p.IDStr() + "/add-to-cart" }
					hx-target={ "#product-" + p.IDStr() } hx-swap="outerHTML"
					title="Add to shopping list" aria-label="Add to shopping list">
					<i class="bi bi-cart-plus"></i>
				</button>
				<button class="btn btn-outline-success btn-sm p-0 px-1"
					hx-post={ "/products/" + p.IDStr() + "/consume" }
					hx-target={ "#product-" + p.IDStr() } hx-swap="outerHTML"
					title="Consume" aria-label="Consume one">
					<i class="bi bi-dash-circle"></i>
				</button>
				<button class="btn btn-outline-primary btn-sm p-0 px-1"
					hx-post={ "/products/" + p.IDStr() + "/add" }
					hx-target={ "#product-" + p.IDStr() } hx-swap="outerHTML"
					title="Add stock" aria-label="Add one">
					<i class="bi bi-plus-circle"></i>
				</button>
				<button class="btn btn-outline-warning btn-sm p-0 px-1"
					hx-get={ "/products/" + p.IDStr() + "/edit" }
					hx-target="#products-area" hx-swap="innerHTML"
					title="Edit" aria-label="Edit product">
					<i class="bi bi-pencil"></i>
				</button>
				<button class="btn btn-outline-danger btn-sm p-0 px-1"
					hx-delete={ "/products/" + p.IDStr() }
					hx-target={ "#product-" + p.IDStr() } hx-swap="outerHTML swap:200ms"
					hx-confirm="Delete this product?"
					title="Delete" aria-label="Delete product">
					<i class="bi bi-trash"></i>
				</button>
				<a class="btn btn-outline-warning btn-sm p-0 px-1"
					href={ templ.SafeURL("https://www.amazon.com/s?k=" + p.Name) }
					target="_blank" title="Amazon" aria-label="Search Amazon">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.958 10.09c0 1.232.029 2.256-.591 3.351-.502.891-1.301 1.438-2.186 1.438-1.214 0-1.922-.924-1.922-2.292 0-2.692 2.415-3.182 4.7-3.182v.685zm3.186 7.705c-.209.189-.512.201-.748.074-1.051-.872-1.238-1.276-1.814-2.106-1.736 1.77-2.964 2.3-5.209 2.3-2.66 0-4.731-1.641-4.731-4.923 0-2.565 1.391-4.309 3.37-5.164 1.715-.754 4.11-.891 5.942-1.095v-.41c0-.753.058-1.642-.383-2.294-.385-.579-1.124-.82-1.775-.82-1.205 0-2.277.618-2.54 1.897-.054.285-.261.567-.549.581l-3.074-.333c-.259-.058-.548-.266-.472-.66C5.771 1.145 9.491 0 12.82 0c1.715 0 3.956.457 5.31 1.756 1.715 1.641 1.551 3.828 1.551 6.209v5.625c0 1.693.702 2.435 1.362 3.349.231.33.282.726-.012.967-.735.614-2.039 1.756-2.757 2.396l-.003-.003-.127.507z"/></svg>
				</a>
				<a class="btn btn-outline-primary btn-sm p-0 px-1 fw-bold"
					href={ templ.SafeURL("https://www.walmart.com/search?q=" + p.Name) }
					target="_blank" title="Walmart" aria-label="Search Walmart">
					W
				</a>
			</div>
		</td>
	</tr>
}

// ProductTable renders the full product table.
templ ProductTable(products []models.Product) {
	<div class="table-responsive">
		<table class="table table-hover align-middle" aria-label="Products list">
			<thead>
				<tr>
					<th>Name</th>
					<th>Location</th>
					<th>Quantity</th>
					<th>Expires</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody id="product-table-body">
				for _, p := range products {
					@ProductRow(p)
				}
			</tbody>
		</table>
	</div>
	if len(products) == 0 {
		<p class="text-center text-body-secondary py-3">No products yet. Add your first one above.</p>
	}
}

// ExpiringSoon renders a compact list for the dashboard.
templ ExpiringSoon(products []models.Product) {
	if len(products) == 0 {
		<p class="text-body-secondary mb-0">Nothing expiring soon. You're all set.</p>
	} else {
		<ul class="list-group list-group-flush">
			for _, p := range products {
				<li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
					<span>{ p.Name }</span>
					<span class="badge text-bg-warning">{ p.ExpiresDisplay() }</span>
				</li>
			}
		</ul>
	}
}

// ShoppingPreview renders a compact shopping list for the dashboard.
templ ShoppingPreview(items []models.ShoppingItem) {
	if len(items) == 0 {
		<p class="text-body-secondary mb-0">Shopping list is empty.</p>
	} else {
		<ul class="list-group list-group-flush">
			for _, item := range items {
				<li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
					<span>{ item.Name }</span>
					<span class="badge text-bg-info">{ item.QuantityStr() }</span>
				</li>
			}
		</ul>
	}
}

func stockBadgeClass(p models.Product) string {
	if p.Quantity <= p.MinStockAmount {
		return "text-bg-danger"
	}
	return "text-bg-success"
}
