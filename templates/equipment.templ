package templates

import (
	"Domicile/internal/models"
	"Domicile/templates/partials"
)

templ EquipmentContent(items []models.EquipmentItem) {
	<div id="equipment-area">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div role="heading" aria-level="2" class="h2"><i class="bi bi-tools me-2"></i>Equipment</div>
			<div class="d-flex gap-2 align-items-center">
				<div class="input-group" style="max-width: 250px;">
					<span class="input-group-text"><i class="bi bi-search"></i></span>
					<input type="text" class="form-control"
						placeholder="Search equipment..." autocomplete="off" aria-label="Search equipment"
						oninput="filterTable(this.value, 'equipment-table-body')"/>
				</div>
			</div>
		</div>
		@partials.EquipmentTable(items)
		<!-- Bulk upload button -->
		<button class="btn btn-outline-info btn-lg rounded-circle shadow position-fixed"
			style="bottom: 2rem; right: 5rem; width: 56px; height: 56px; z-index: 1050;"
			data-bs-toggle="modal" data-bs-target="#bulk-upload-modal"
			title="Bulk Import from Files">
			<i class="bi bi-cloud-upload"></i>
		</button>
		<!-- Single add button -->
		<button class="btn btn-primary btn-lg rounded-circle shadow position-fixed"
			style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1050;"
			hx-get="/inventory/new"
			hx-target="#equipment-area"
			hx-swap="innerHTML"
			title="Add Equipment" aria-label="Add Equipment">
			<i class="bi bi-plus-lg"></i>
		</button>
		<!-- Bulk Upload Modal -->
		<div class="modal fade" id="bulk-upload-modal" tabindex="-1" aria-labelledby="bulk-upload-label" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<div role="heading" aria-level="5" class="modal-title" id="bulk-upload-label"><i class="bi bi-cloud-upload me-2"></i>Bulk Import Equipment</div>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<p>Select multiple files (PDFs, images) to create equipment entries automatically.</p>
						<p class="text-body-secondary">
							<i class="bi bi-info-circle me-1"></i>
							The equipment name is derived from the filename:
						</p>
						<ul class="text-body-secondary small">
							<li><code>Kitchen_Stove_Manual.pdf</code> → <strong>Kitchen Stove Manual</strong></li>
							<li><code>DishwasherGuide.pdf</code> → <strong>Dishwasher Guide</strong> (PascalCase split)</li>
							<li><code>my-vacuum.pdf</code> → <strong>my vacuum</strong> (dashes to spaces)</li>
						</ul>
						<form hx-post="/inventory/bulk-upload" hx-encoding="multipart/form-data"
							hx-target="#main-content" hx-swap="innerHTML">
							<div class="mb-3">
								<input type="file" class="form-control" name="files" multiple
									accept=".pdf,.jpg,.jpeg,.png,.gif,.webp"/>
							</div>
							<button type="submit" class="btn btn-success" data-bs-dismiss="modal">
								<i class="bi bi-upload me-1"></i>Import Files
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ EquipmentPage(items []models.EquipmentItem) {
	@Layout("Equipment") {
		@EquipmentContent(items)
	}
}
