package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-bs-theme="dark">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - Domicile</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet"/>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<link href="/static/css/app.css" rel="stylesheet"/>
	</head>
	<body>
		<nav class="navbar navbar-expand-lg sticky-top">
			<div class="container-fluid px-3">
				<a class="navbar-brand d-flex align-items-center" href="/"
					hx-get="/" hx-target="#main-content" hx-push-url="true">
					<i class="bi bi-house-heart fs-4 me-2"></i>
					<span>Domicile</span>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
					aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link" href="/products"
								hx-get="/products" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-box-seam me-1"></i>Products
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/locations"
								hx-get="/locations" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-geo-alt me-1"></i>Locations
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/shopping"
								hx-get="/shopping" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-cart3 me-1"></i>Shopping
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/chores"
								hx-get="/chores" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-check2-square me-1"></i>Chores
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/recipes"
								hx-get="/recipes" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-journal-text me-1"></i>Recipes
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/equipment"
								hx-get="/equipment" hx-target="#main-content" hx-push-url="true">
								<i class="bi bi-tools me-1"></i>Equipment
							</a>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button"
								data-bs-toggle="dropdown" aria-expanded="false">
								<i class="bi bi-three-dots me-1"></i>More
							</a>
							<ul class="dropdown-menu dropdown-menu-dark">
								<li>
									<a class="dropdown-item" href="/tasks"
										hx-get="/tasks" hx-target="#main-content" hx-push-url="true">
										<i class="bi bi-list-task me-2"></i>Tasks
									</a>
								</li>
								<li>
									<a class="dropdown-item" href="/batteries"
										hx-get="/batteries" hx-target="#main-content" hx-push-url="true">
										<i class="bi bi-battery-half me-2"></i>Batteries
									</a>
								</li>
								<li>
									<a class="dropdown-item" href="/meal-plan"
										hx-get="/meal-plan" hx-target="#main-content" hx-push-url="true">
										<i class="bi bi-calendar-week me-2"></i>Meal Plan
									</a>
								</li>
							</ul>
						</li>
					</ul>
					<ul class="navbar-nav ms-auto align-items-center">
						<li class="nav-item me-2">
							<a class="nav-link" href="/settings"
								hx-get="/settings" hx-target="#main-content" hx-push-url="true"
								title="Settings">
								<i class="bi bi-gear-fill fs-5"></i>
							</a>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle d-flex align-items-center p-0" href="#"
								role="button" data-bs-toggle="dropdown" aria-expanded="false"
								title="User menu">
								<div class="user-avatar d-flex align-items-center justify-content-center rounded-circle bg-primary text-white"
									style="width:34px;height:34px;font-size:0.85rem;">
									<i class="bi bi-person-fill"></i>
								</div>
							</a>
							<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
								<li>
									<a class="dropdown-item" href="/profile"
										hx-get="/profile" hx-target="#main-content" hx-push-url="true">
										<i class="bi bi-person me-2"></i>My Profile
									</a>
								</li>
								<li><hr class="dropdown-divider"/></li>
								<li>
									<a class="dropdown-item" href="/logout">
										<i class="bi bi-box-arrow-right me-2"></i>Sign Out
									</a>
								</li>
							</ul>
						</li>
					</ul>
				</div>
			</div>
		</nav>
		<main class="container-fluid px-3 px-md-4" id="main-content">
			{ children... }
		</main>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
	</body>
	</html>
}
