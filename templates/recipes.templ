package templates

import (
	"Domicile/internal/models"
	"Domicile/templates/partials"
)

templ RecipesContent(recipes []models.Recipe) {
	<div id="recipes-area">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div role="heading" aria-level="2" class="h2"><i class="bi bi-journal-text me-2"></i>Recipes</div>
			<div class="input-group" style="max-width: 250px;">
				<span class="input-group-text"><i class="bi bi-search"></i></span>
				<input type="text" class="form-control" placeholder="Search recipes..." autocomplete="off" aria-label="Search recipes"
					oninput="filterCards(this.value)"/>
			</div>
		</div>
		<!-- Import from URL -->
		<div class="card mb-4">
			<div class="card-body py-2">
				<form hx-post="/recipes/scrape" hx-target="#main-content" hx-swap="innerHTML" class="d-flex gap-2 align-items-center">
					<i class="bi bi-globe2 text-body-secondary"></i>
					<input type="url" class="form-control form-control-sm" name="url" placeholder="Paste recipe URL to import..." aria-label="Recipe URL" required/>
					<button type="submit" class="btn btn-sm btn-success text-nowrap">
						<i class="bi bi-download me-1"></i>Import
					</button>
				</form>
			</div>
		</div>
		@partials.RecipeGrid(recipes)
		<button class="btn btn-primary btn-lg rounded-circle shadow position-fixed"
			style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1050;"
			hx-get="/recipes/new" hx-target="#recipes-area" hx-swap="innerHTML"
			title="Add Recipe" aria-label="Add Recipe">
			<i class="bi bi-plus-lg"></i>
		</button>
	</div>
}

templ RecipesPage(recipes []models.Recipe) {
	@Layout("Recipes") {
		@RecipesContent(recipes)
	}
}

templ RecipeViewPage(r models.RecipeDetail) {
	@Layout(r.Name) {
		@partials.RecipeView(r)
	}
}
