package templates

import "Domicile/internal/models"

// HomeContent is the inner content — used by htmx partial swaps
templ HomeContent(stats models.DashboardStats) {
	<div role="heading" aria-level="2" class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard</div>
	<div class="row g-4 mb-4">
		<div class="col-md-3">
			<a class="card border-0 shadow-sm text-decoration-none" style="background-color: #1a3a5c; cursor: pointer;"
				href="/products" hx-get="/products" hx-target="#main-content" hx-push-url="true">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<div role="heading" aria-level="6" class="card-subtitle mb-1 text-lightskyblue">Products</div>
							<div role="heading" aria-level="2" class="card-title mb-0 text-white">{ stats.ProductCountStr() }</div>
						</div>
						<i class="bi bi-box-seam fs-1 text-cornflowerblue"></i>
					</div>
				</div>
			</a>
		</div>
		<div class="col-md-3">
			<a class="card border-0 shadow-sm text-decoration-none" style="background-color: #5c4a1a; cursor: pointer;"
				href="/stock" hx-get="/stock" hx-target="#main-content" hx-push-url="true">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<div role="heading" aria-level="6" class="card-subtitle mb-1 text-wheat">Expiring Soon</div>
							<div role="heading" aria-level="2" class="card-title mb-0 text-white">{ stats.ExpiringSoonStr() }</div>
						</div>
						<i class="bi bi-exclamation-triangle fs-1 text-goldenrod"></i>
					</div>
				</div>
			</a>
		</div>
		<div class="col-md-3">
			<a class="card border-0 shadow-sm text-decoration-none" style="background-color: #5c1a1a; cursor: pointer;"
				href="/stock" hx-get="/stock" hx-target="#main-content" hx-push-url="true">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<div role="heading" aria-level="6" class="card-subtitle mb-1 text-lightsalmon">Below Min Stock</div>
							<div role="heading" aria-level="2" class="card-title mb-0 text-white">{ stats.BelowMinStockStr() }</div>
						</div>
						<i class="bi bi-arrow-down-circle fs-1 text-indianred"></i>
					</div>
				</div>
			</a>
		</div>
		<div class="col-md-3">
			<a class="card border-0 shadow-sm text-decoration-none" style="background-color: #1a4a5c; cursor: pointer;"
				href="/shopping" hx-get="/shopping" hx-target="#main-content" hx-push-url="true">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<div role="heading" aria-level="6" class="card-subtitle mb-1 text-paleturquoise">Shopping Items</div>
							<div role="heading" aria-level="2" class="card-title mb-0 text-white">{ stats.ShoppingItemsStr() }</div>
						</div>
						<i class="bi bi-cart3 fs-1 text-mediumturquoise"></i>
					</div>
				</div>
			</a>
		</div>
	</div>
	<div class="row g-4">
		<div class="col-md-6">
			<div class="card">
				<div class="card-header d-flex justify-content-between align-items-center">
					<span><i class="bi bi-exclamation-triangle me-2"></i>Expiring Soon</span>
					<a href="/products" class="btn btn-sm btn-outline-light">View All</a>
				</div>
				<div class="card-body" id="expiring-list"
					hx-get="/partials/expiring-soon"
					hx-trigger="load"
					hx-swap="innerHTML">
					<div class="text-center text-body-secondary py-3">
						<div class="spinner-border spinner-border-sm" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="card">
				<div class="card-header d-flex justify-content-between align-items-center">
					<span><i class="bi bi-cart3 me-2"></i>Shopping List</span>
					<a href="/shopping" class="btn btn-sm btn-outline-light">View All</a>
				</div>
				<div class="card-body" id="shopping-preview"
					hx-get="/partials/shopping-preview"
					hx-trigger="load"
					hx-swap="innerHTML">
					<div class="text-center text-body-secondary py-3">
						<div class="spinner-border spinner-border-sm" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// HomePage is the full page — used for direct browser navigation
templ HomePage(stats models.DashboardStats) {
	@Layout("Dashboard") {
		@HomeContent(stats)
	}
}
